rust/lain-supervisor/target/

# Project intelligence: fingerprints and symbol indexes, rebuilt from the
# tree on demand. Machine state, never source. See src/projectindex.js.
.lain/
# (.lain-probe/ was ignored here while Lain Probe was an integrated client —
# it is an external instrument as of the 2026-09 phase, and its directory is
# no longer this repository's to hide.)

# Local agent / IDE state, never source.
.claude/

# benchmark working copies and baselines (the pristine fixture is version-controlled; these are per-run outputs)
bench/out/

# Python workers are source; interpreter caches are machine output.
__pycache__/
*.py[cod]

# The WebView2 SDK LAIN Desktop links against. The RUNTIME is part of
# Windows; only the SDK is vendored, and it is fetched on first build with a
# pinned version and a recorded hash. Binaries are machine state, never source.
# See native/vendor.js.
native/vendor/

# The built installer artifact. Rebuilt by `npm run dist`; never source.
dist/
