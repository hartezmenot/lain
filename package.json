{
  "name": "lain",
  "version": "0.2.7",
  "description": "LAIN — an evidence-driven coding agent for the terminal and the desktop. The model decides; LAIN executes, observes, verifies and keeps the receipts.",
  "license": "MIT",
  "bin": {
    "lain": "bin/lain.js"
  },
  "main": "src/cli.js",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "agent",
    "cli",
    "coding-agent",
    "llm",
    "harness",
    "verification",
    "evidence"
  ],
  "files": [
    "bin/",
    "skills/",
    "src/",
    "distribution/",
    "harness/",
    "native/pty.cs",
    "README.md",
    "docs/HARNESS.md",
    "docs/COWORK.md",
    "docs/BOT.md",
    "docs/BOT-ARCHITECTURE.md",
    "docs/MODEL-SOURCES.md",
    "docs/INSTALL.md"
  ],
  "scripts": {
    "start": "node bin/lain.js",
    "desktop": "node bin/lain.js --desktop",
    "setup": "node distribution/install.js",
    "setup:remove": "node distribution/uninstall.js",
    "test": "node tests/run.js",
    "test:unit": "node tests/run.js unit",
    "test:integration": "node tests/run.js integration",
    "test:core": "node tests/run.js unit && node tests/run.js integration",
    "test:cli": "node tests/run.js cli",
    "test:tty": "node tests/run.js cli tty",
    "test:harness": "node tests/run.js harness",
    "test:design": "node tests/run.js unit design && node tests/run.js integration design",
    "test:smoke": "node tests/run.js smoke",
    "test:workflow": "node tests/run.js workflow",
    "test:global": "node tests/run.js global",
    "test:live": "node tests/run.js live",
    "test:distribution": "node tests/run.js distribution",
    "vendor": "node -e \"Promise.all([require('./harness/native/vendor').ensure({quiet:false}),require('./harness/webvendor').ensureAll()]).then(r=>console.log(JSON.stringify(r)))\"",
    "build:harness": "node -e \"const r=require('./src/desktop').build({quiet:false});console.log(r.ok?r.exe:r.why);process.exit(r.ok?0:1)\"",
    "build:design": "npm ci --omit=dev --prefix packages/design-core",
    "build:supervisor": "cargo build --release --manifest-path rust/lain-supervisor/Cargo.toml",
    "build:installer": "node distribution/release.js --unsigned",
    "release": "node distribution/release.js",
    "dist": "node distribution/release.js"
  }
}
