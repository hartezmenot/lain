{
  "name": "lain",
  "version": "0.2.0",
  "description": "LAIN — an evidence-driven coding agent for the terminal and the desktop. The model decides; LAIN executes, observes, verifies and keeps the receipts.",
  "license": "MIT",
  "bin": {
    "lain": "bin/lain.js",
    "noema": "bin/noema.js"
  },
  "main": "src/cli.js",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "agent",
    "cli",
    "coding-agent",
    "llm",
    "harness",
    "verification",
    "evidence"
  ],
  "files": [
    "bin/",
    "skills/",
    "src/",
    "distribution/",
    "harness/",
    "native/pty.cs",
    "README.md",
    "docs/HARNESS.md",
    "docs/COWORK.md",
    "docs/BOT.md",
    "docs/BOT-ARCHITECTURE.md",
    "docs/MODEL-SOURCES.md",
    "docs/INSTALL.md"
  ],
  "scripts": {
    "start": "node bin/lain.js",
    "setup": "node distribution/install.js",
    "setup:remove": "node distribution/uninstall.js",
    "test": "node tests/run.js",
    "test:unit": "node tests/run.js unit",
    "test:integration": "node tests/run.js integration",
    "test:smoke": "node tests/run.js smoke",
    "test:workflow": "node tests/run.js workflow",
    "test:cli": "node tests/run.js cli",
    "test:harness": "node tests/run.js harness",
    "test:global": "node tests/run.js global",
    "test:live": "node tests/run.js live",
    "test:distribution": "node tests/run.js distribution",
    "dist": "node distribution/release.js"
  }
}
